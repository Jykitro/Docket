FROM --platform=$BUILDPLATFORM golang:1.27.4-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/docket ./cmd/docket
COPY internal ./internal
COPY skills ./skills
ARG TARGETOS
ARG TARGETARCH
RUN mkdir -p internal/web/dist && touch internal/web/dist/.gitkeep && CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/plandillo ./cmd/docket

FROM gcr.io/distroless/static-debian13:nonroot@sha256:8ce6dd87e9823c5b48dcfb2c8604714ccb351ce59607327bcc4957448da279b5
COPY --from=build /out/plandillo /app/plandillo
EXPOSE 8080
ENTRYPOINT ["/app/plandillo", "vercel-replies"]
