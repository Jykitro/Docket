        <div class={quota}><span class={quotaLabel}>Workspace quota</span><strong class:list={[quotaValue, 'text-dim']}>Larger</strong></div>
        <a class:list={[btn, md, ghost, 'w-full']} href="https://github.com/huntly-digital/plandillo" data-cta="price-cloud-watch">Watch on GitHub for the launch</a>
        <Ticks dim items={['Everything in Cloud Free', 'A larger workspace quota']} />
      </div>
    </div>
    <p class="mx-auto mt-6 max-w-[64ch] text-center text-sm text-dim">The quota counts tasks, wiki pages, icons, activity and trash in a workspace. Emptying the trash frees space.</p>
  </section>

