        <Ticks items={['Board, project wiki and activity log', 'Agents over MCP and Code Mode', 'One or many accounts, a workspace each', 'SQLite or PostgreSQL', 'MIT-licensed source']} />
      </div>
      <div class:list={[price, 'border-featured-line bg-[linear-gradient(180deg,var(--color-featured-top)_0%,var(--color-surface)_60%)] shadow-[0_30px_80px_-40px_rgba(84,48,153,.6)] max-board:-order-1']}>
