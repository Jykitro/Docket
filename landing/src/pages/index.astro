        <div class={amount}><strong class={amountValue}>Free</strong><span class="text-sm text-dim">hosted by us</span></div>
        <div class={quota}><span class={quotaLabel}>Workspace quota</span><strong class={quotaValue}>5 MB</strong></div>
        <a class:list={[btn, md, primary, 'w-full']} data-app href="https://app.plandillo.dev/register" data-cta="price-cloudfree">Try the free demo</a>
        <Ticks items={['Everything in Self-hosted', 'Nothing to install or update', 'Usage shown in Settings']} />
      </div>
      <div class:list={[price, 'border-dashed border-line-dash bg-page-2']}>
        <div class={priceHead}><div class="row-between"><h3 class={priceTitle}>Cloud</h3><span class="pill">Coming soon</span></div><p class={muted}>The same hosted Plandillo with room for real projects.</p></div>
