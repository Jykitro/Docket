DOCKET_ADDR=:7777
DOCKET_DB=/data/docket.db
DOCKET_BACKUP_DIR=/data/backups
# Optional. Leave empty: a token is generated on first start, shown once in the log and later in the MCP tab,
# where it can be rotated. If you set it here (openssl rand -hex 32), it wins and rotation in the UI is disabled.
DOCKET_MCP_TOKEN=
DOCKET_ALLOWED_HOSTS=localhost,127.0.0.1,docket.localhost
# Optional: a JSON file of projects and tasks imported once, while the database has no projects (see README).
DOCKET_SEED=
TZ=Asia/Ho_Chi_Minh
