# local (default) or selfhost (login and isolated profiles)
DOCKET_MODE=local
# Optional, selfhost only. Empty keeps SQLite. URL-encode credentials in a PostgreSQL URL.
# DOCKET_POSTGRES_DSN=postgres://docket:password@postgres:5432/docket?sslmode=verify-full
DOCKET_POSTGRES_DSN=
# Code Mode Unix socket shared with the isolated code-runner container.
# DOCKET_CODE_SOCKET=/run/docket-code/runner.sock
# Native binary defaults to loopback. The container defaults to :7777.
# DOCKET_ADDR=127.0.0.1:7777
DOCKET_DB=/data/docket.db
DOCKET_BACKUP_DIR=/data/backups
# Optional. Leave empty: a token is generated on first start, available in the Integrations tab,
# where it can be rotated. If you set it here (openssl rand -hex 32), it wins and rotation in the UI is disabled.
DOCKET_MCP_TOKEN=
DOCKET_ALLOWED_HOSTS=localhost,127.0.0.1,docket.localhost
# Selfhost: exact peer addresses or CIDRs of trusted reverse proxies. Empty trusts none.
DOCKET_TRUSTED_PROXIES=
# Optional canonical browser origin for passkeys (including a custom HTTPS port).
# DOCKET_PASSKEY_ORIGIN=https://planner.example.com
# Optional: a JSON file of projects and tasks imported once, while the database has no projects (see README).
DOCKET_SEED=
TZ=Asia/Ho_Chi_Minh
