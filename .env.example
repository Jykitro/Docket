# local (default) or selfhost (login and isolated profiles)
PLANDILLO_MODE=local
# Optional, selfhost only. Empty keeps SQLite. URL-encode credentials in a PostgreSQL URL.
# PLANDILLO_POSTGRES_DSN=postgres://plandillo:password@postgres:5432/plandillo?sslmode=verify-full
PLANDILLO_POSTGRES_DSN=
# PostgreSQL connections kept open and reused between requests (1-500). Mind the server's max_connections,
# shared by every replica and every other client of that database.
# PLANDILLO_POSTGRES_MAX_CONNS=10
# Code Mode Unix socket shared with the isolated code-runner container.
# PLANDILLO_CODE_SOCKET=/run/plandillo-code/runner.sock
# Native binary defaults to loopback. The container defaults to :7777.
# PLANDILLO_ADDR=127.0.0.1:7777
# Optional: serve HTTPS (and HTTP/2) directly instead of behind a proxy. Set both or neither.
# PLANDILLO_TLS_CERT=/data/tls/fullchain.pem
# PLANDILLO_TLS_KEY=/data/tls/privkey.pem
# Empty: /data/plandillo.db, or /data/docket.db when an older installation already has one.
PLANDILLO_DB=
PLANDILLO_BACKUP_DIR=/data/backups
# Optional. Leave empty: a token is generated on first start, available in the Integrations tab,
# where it can be rotated. If you set it here (openssl rand -hex 32), it wins and rotation in the UI is disabled.
PLANDILLO_MCP_TOKEN=
PLANDILLO_ALLOWED_HOSTS=localhost,127.0.0.1,plandillo.localhost
# Selfhost: exact peer addresses or CIDRs of trusted reverse proxies. Empty trusts none.
PLANDILLO_TRUSTED_PROXIES=
# Shared TOTP key for PostgreSQL replicas (openssl rand -base64 32). SQLite generates a private totp.key.
# PLANDILLO_TOTP_KEY=
# Optional canonical browser origin for passkeys (including a custom HTTPS port).
# PLANDILLO_PASSKEY_ORIGIN=https://planner.example.com
# Optional: a JSON file of projects and tasks imported once, while the database has no projects (see README).
PLANDILLO_SEED=
TZ=Europe/Kyiv
